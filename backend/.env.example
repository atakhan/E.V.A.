# Скопируйте в backend/.env перед docker compose up (без .env сервисы не поднимутся).

PORT=8000

# Postgres (контейнер postgres читает POSTGRES_*)
POSTGRES_USER=eva
POSTGRES_PASSWORD=eva
POSTGRES_DB=eva
DATABASE_URL=postgresql+psycopg2://eva:eva@postgres:5432/eva
REDIS_URL=redis://redis:6379/0

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVA_CREDENTIALS_KEY=

# stub = in-memory telegram; real = Bot API via stored credentials
EVA_TELEGRAM_MODE=stub

# Dev long polling — enable when a real bot token credential exists
EVA_TELEGRAM_POLLING=false

# stub = local LlmStubTool under polza_ai_llm id; real = Polza.ai Chat Completions
EVA_POLZA_MODE=real
POLZA_API_BASE=https://polza.ai/api/v1
POLZA_DEFAULT_MODEL=openai/gpt-4o-mini

# Public URL shown in Web Client ingress UI (browser / host machine)
EVA_PUBLIC_URL=http://localhost:8000
# Rewrite localhost in credential URLs when E.V.A. runs in Docker
EVA_WEB_CLIENT_DOCKER_REWRITE=true
EVA_WEB_CLIENT_DOCKER_HOST=host.docker.internal

# Public base URL for setWebhook (e.g. https://abc123.ngrok.io)
EVA_WEBHOOK_BASE=

# agent_slug=skill_id pairs for ingress routing
EVA_DEFAULT_SKILL_IDS=foreman=process_foreman_request,supplier=chat_with_supplier

# Dev startup: seed demo agents (foreman, supplier) and remove leftover test agents
EVA_SEED_DEMO_AGENTS=true
EVA_PRUNE_EPHEMERAL_AGENTS=true
EVA_AUTO_MIGRATE=true

# Frontend dev server (docker compose service frontend)
VITE_API_PROXY=http://backend:8000
