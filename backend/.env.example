# E.V.A. backend environment (copy to .env for local overrides)

DATABASE_URL=postgresql+psycopg2://eva:eva@postgres:5432/eva
REDIS_URL=redis://redis:6379/0

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVA_CREDENTIALS_KEY=

# stub = in-memory telegram; real = Bot API via stored credentials
EVA_TELEGRAM_MODE=stub

# Dev long polling — enable when a real bot token credential exists
EVA_TELEGRAM_POLLING=false

# Public base URL for setWebhook (e.g. https://abc123.ngrok.io)
EVA_WEBHOOK_BASE=

# agent_slug=skill_id pairs for ingress routing
EVA_DEFAULT_SKILL_IDS=foreman=process_foreman_request
