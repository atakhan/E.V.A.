EVA_TELEGRAM_MODE=real
EVA_TELEGRAM_POLLING=false
EVA_POLZA_MODE=real
POLZA_API_BASE=https://polza.ai/api/v1
POLZA_DEFAULT_MODEL=openai/gpt-4o-mini
EVA_DEFAULT_SKILL_IDS=
EVA_PUBLIC_URL=https://eva-stage.tetrakom-crm-miniapp.ru
EVA_WEB_CLIENT_DOCKER_HOST=host.docker.internal
EVA_WEB_CLIENT_DOCKER_REWRITE=false
EVA_TOOL_INPUT_VALIDATION=warn
EVA_EVENT_MAX_ATTEMPTS=5
EVA_PRUNE_EPHEMERAL_AGENTS=false
