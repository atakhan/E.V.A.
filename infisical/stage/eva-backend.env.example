PORT=8000
DATABASE_URL=postgresql+psycopg2://eva:change_me_strong_password@eva-postgres-stage:5432/eva
REDIS_URL=redis://eva-redis-stage:6379/0
EVA_EVENT_STREAM=eva:events
EVA_EVENT_CONSUMER_GROUP=eva-runtime
EVA_AUTO_MIGRATE=true
EVA_CREDENTIALS_KEY=replace_with_fernet_key
