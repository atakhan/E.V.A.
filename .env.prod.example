# Сводка ключей, которые Infisical env=prod должен отдать compose.
# Не копировать на сервер: папки /eva-postgres, /eva-redis, /eva-backend
# (шаблоны — infisical/prod/*.env.example, загрузка — make prod-secrets-upload).

# --- PostgreSQL (eva-postgres-prod) ---
POSTGRES_USER=eva
POSTGRES_DB=eva
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql+psycopg2://eva:change_me_strong_password@eva-postgres-prod:5432/eva

# --- Redis (eva-redis-prod) ---
REDIS_URL=redis://eva-redis-prod:6379/0

# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVA_CREDENTIALS_KEY=

# Public URLs behind nginx_proxy
EVA_PUBLIC_URL=https://eva.tetrakom-crm-miniapp.ru
EVA_WEBHOOK_BASE=https://eva.tetrakom-crm-miniapp.ru

EVA_TELEGRAM_MODE=real
EVA_TELEGRAM_POLLING=false
EVA_POLZA_MODE=real
POLZA_API_BASE=https://polza.ai/api/v1
POLZA_DEFAULT_MODEL=openai/gpt-4o-mini

EVA_WEB_CLIENT_DOCKER_REWRITE=false
EVA_AUTO_MIGRATE=true
EVA_PRUNE_EPHEMERAL_AGENTS=false
